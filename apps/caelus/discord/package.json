{
	"name": "@thatskyapplication/caelus",
	"private": true,
	"files": [
		"distribution"
	],
	"type": "module",
	"scripts": {
		"build": "tsc",
		"deploy-commands": "tsx source/utility/deploy-commands.ts",
		"deploy-commands-dev": "tsx --env-file=.env.development source/utility/deploy-commands.ts | pino-pretty",
		"dev": "tsx --env-file=.env.development source/index.ts | pino-pretty",
		"format": "oxlint --fix . && oxfmt .",
		"lint": "oxfmt --check . && oxlint .",
		"start": "node --import ./distribution/sentry.js distribution/index.js",
		"test": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "catalog:",
		"@discordjs/collection": "catalog:",
		"@discordjs/core": "catalog:",
		"@discordjs/rest": "catalog:",
		"@discordjs/ws": "catalog:",
		"@hono/node-server": "catalog:",
		"@sapphire/snowflake": "^3.5.5",
		"@sentry/node": "catalog:",
		"@thatskyapplication/utility": "workspace:^",
		"croner": "catalog:",
		"diff": "^8.0.4",
		"hono": "catalog:",
		"i18next": "catalog:",
		"kysely": "catalog:",
		"p-queue": "^9.3.0",
		"pg": "catalog:",
		"pino": "catalog:",
		"sharp": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@actions/core": "^2.0.2",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"pino-pretty": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
