{
	"name": "@thatskyapplication/caelus",
	"private": true,
	"files": [
		"distribution"
	],
	"type": "module",
	"scripts": {
		"build": "tsc",
		"deploy-commands": "tsx source/utility/deploy-commands.ts",
		"deploy-commands-dev": "tsx --env-file=.env.development source/utility/deploy-commands.ts | pino-pretty",
		"dev": "tsx --env-file=.env.development source/index.ts | pino-pretty",
		"format": "oxlint --fix . && oxfmt .",
		"lint": "oxfmt --check . && oxlint .",
		"start": "node --import ./distribution/sentry.js distribution/index.js",
		"test": "tsc --noEmit"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1061.0",
		"@discordjs/collection": "^2.1.1",
		"@discordjs/core": "dev",
		"@discordjs/rest": "dev",
		"@discordjs/ws": "dev",
		"@hono/node-server": "^2.0.12",
		"@sapphire/snowflake": "^3.5.5",
		"@sentry/node": "^10.69.0",
		"@thatskyapplication/utility": "workspace:^",
		"croner": "^9.1.0",
		"diff": "^8.0.4",
		"hono": "^4.12.32",
		"i18next": "^26.3.6",
		"kysely": "^0.28.17",
		"p-queue": "^9.3.0",
		"pg": "^8.21.0",
		"pino": "^10.3.0",
		"sharp": "^0.35.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@actions/core": "^2.0.2",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.22.4",
		"typescript": "^7.0.2"
	}
}
