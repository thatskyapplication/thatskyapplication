{
	"name": "@thatskyapplication/notifications",
	"private": true,
	"files": [
		"distribution"
	],
	"type": "module",
	"scripts": {
		"build": "tsc",
		"dev": "tsx --env-file=.env.development source/index.ts | pino-pretty",
		"format": "oxlint --fix . && oxfmt .",
		"lint": "oxfmt --check . && oxlint .",
		"start": "node --import ./distribution/sentry.js distribution/index.js",
		"test": "tsc --noEmit"
	},
	"dependencies": {
		"@discordjs/core": "dev",
		"@discordjs/rest": "dev",
		"@sentry/node": "^10.69.0",
		"@thatskyapplication/utility": "workspace:^",
		"croner": "^9.1.0",
		"i18next": "^26.3.6",
		"kysely": "^0.28.17",
		"pg": "^8.21.0",
		"pino": "^10.3.0"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"pino-pretty": "^13.1.3",
		"tsx": "^4.22.4",
		"typescript": "^7.0.2"
	}
}
