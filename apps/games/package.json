{
	"name": "@thatskyapplication/games",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "vite build && tsc --project tsconfig.server.json",
		"dev": "pnpm run \"/^dev:/\"",
		"dev:client": "vite",
		"dev:server": "tsx watch --env-file=.env.development source/server/index.ts | pino-pretty",
		"format": "oxlint --fix . && oxfmt .",
		"lint": "oxfmt --check . && oxlint .",
		"start": "node --import ./build/server/sentry.js ./build/server/index.js",
		"test": "tsc --project tsconfig.client.json --noEmit && tsc --project tsconfig.server.json --noEmit"
	},
	"dependencies": {
		"@discord/embedded-app-sdk": "^2.5.0",
		"@discordjs/core": "catalog:",
		"@discordjs/rest": "catalog:",
		"@hono/node-server": "catalog:",
		"@icons-pack/react-simple-icons": "catalog:",
		"@sentry/browser": "^10.70.0",
		"@sentry/node": "catalog:",
		"@sentry/node-native": "catalog:",
		"@sentry/profiling-node": "catalog:",
		"@thatskyapplication/utility": "workspace:^",
		"clsx": "catalog:",
		"hono": "catalog:",
		"i18next": "catalog:",
		"kysely": "catalog:",
		"lucide-react": "catalog:",
		"pg": "catalog:",
		"pino": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"ws": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@sentry/vite-plugin": "^5.3.0",
		"@tailwindcss/vite": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"@types/ws": "catalog:",
		"@vitejs/plugin-react": "^6.1.1",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"pino-pretty": "catalog:",
		"tailwindcss": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	}
}
