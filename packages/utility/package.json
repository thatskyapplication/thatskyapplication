{
	"name": "@thatskyapplication/utility",
	"private": true,
	"files": [
		"distribution"
	],
	"type": "module",
	"types": "./distribution/index.d.ts",
	"exports": "./distribution/index.js",
	"scripts": {
		"build": "tsdown",
		"crowdin": "tsx scripts/crowdin.ts",
		"format": "oxlint --fix . && oxfmt .",
		"kysely": "kysely-codegen --dialect postgres --out-file source/database/schema.ts",
		"lint": "oxfmt --check . && oxlint .",
		"locale": "tsx scripts/locale.ts",
		"test": "tsx --test __tests__/*.test.ts && tsc --noEmit"
	},
	"dependencies": {
		"@discordjs/collection": "^2.1.1",
		"discord-api-types": "^0.38.50",
		"kysely": "^0.28.17",
		"temporal-polyfill": "^1.0.1"
	},
	"devDependencies": {
		"@types/node": "^26.1.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"kysely-codegen": "^0.20.0",
		"pg": "^8.22.0",
		"tsdown": "^0.22.14",
		"tsx": "^4.22.4",
		"typescript": "npm:@typescript/typescript6@^6.0.2"
	}
}
