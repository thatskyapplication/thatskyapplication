{
	"name": "@thatskyapplication/thatskyapplication",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm --recursive build",
		"format": "oxlint --fix . && oxfmt .",
		"knip": "knip && knip --strict --include unlisted",
		"lint": "oxfmt --check . && oxlint .",
		"lint:ci": "oxfmt --check . && oxlint --format=github .",
		"test": "pnpm --recursive test",
		"update": "pnpm update --interactive --latest --recursive && pre-commit autoupdate"
	},
	"devDependencies": {
		"knip": "^6.29.0",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"oxlint-tsgolint": "7.0.2001",
		"typescript": "^7.0.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.10.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": ">=26",
			"onFail": "error"
		}
	}
}
